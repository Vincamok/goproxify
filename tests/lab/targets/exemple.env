# Cible de test distante. Copier en targets/MA-CIBLE.env (ignoré par git) puis : tests/lab/run-security.sh --target tests/lab/targets/MA-CIBLE.env
# Ne jamais commiter ce fichier rempli. Le jeton peut aussi venir de l'environnement : LAB_ADMIN_TOKEN=gpx_pat_... tests/lab/run-security.sh --target ...

# Nom lu dans le rapport et à retaper pour confirmer le lancement
LAB_TARGET_NAME=prod-lan

# API Admin de la cible (https avec certificat auto-signé : LAB_ADMIN_INSECURE=1)
LAB_ADMIN_URL=https://192.168.1.10:9443
LAB_ADMIN_INSECURE=0

# Jeton d'API (Admin > Paramètres > Mes tokens API), durée courte, à révoquer ensuite.
# Sécurité : proxies:read, proxies:write, proxies:delete, certs:read, certs:write, + audit:read et security:write pour la section « bans ».
# Charge : proxies:read, proxies:write, proxies:delete, + nodes:read pour le CPU et la mémoire de la passerelle dans le rapport.
#LAB_ADMIN_TOKEN=gpx_pat_...

# IP LAN de la passerelle (ports 80 et 443 : les routes de test y sont servies)
LAB_EDGE_IP=192.168.1.10

# IP LAN de CETTE machine, vue de la passerelle : lab-backend et lab-sim y sont publiés (ports 9000-9008 et 9999).
# La passerelle doit pouvoir les joindre (pare-feu).
LAB_BACKEND_HOST=192.168.1.50

# Adresse de cette machine vue de la passerelle, mise en liste blanche d'Ephor sur les routes de test pour ne pas être bannie.
# Avec Docker Desktop (Windows, macOS) c'est l'IP LAN de la machine, pas celle du conteneur.
LAB_RUNNER_CIDR=192.168.1.50/32

# 1 = la section « rights » crée un compte et une équipe de test dans l'Admin visé (supprimés ensuite). Exige un jeton de session, pas un PAT.
LAB_ALLOW_ACCOUNTS=0
