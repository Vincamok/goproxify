# Dockerfile CI — utilise le binaire pré-compilé par le step "compile" du pipeline.
FROM scratch

COPY dist/goproxify /goproxify
COPY dist/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
# Config de production (pas internal/*/config.json = chemins de dev)
COPY services/landing/config.json /internal/landing/config.json

EXPOSE 3000

ENTRYPOINT ["/goproxify", "landing"]
